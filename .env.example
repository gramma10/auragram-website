# ─────────────────────────────────────────────────────────────
#  AURAGRAM — Αντιγράψτε το σε .env.local και συμπληρώστε
# ─────────────────────────────────────────────────────────────

# Το domain σας (χωρίς / στο τέλος)
NEXT_PUBLIC_SITE_URL=https://auragram.gr

# Cal.com: το κομμάτι μετά το cal.com/ — π.χ. auragram/xartis-ai
# Χωρίς αυτό, η φόρμα δουλεύει αλλά δεν εμφανίζεται ημερολόγιο.
NEXT_PUBLIC_CAL_LINK=

# Πού πάει το lead: webhook του n8n / Make.
# Χωρίς αυτό το lead απλώς καταγράφεται στα logs — ΜΗΝ το ξεχάσετε στο production.
LEAD_WEBHOOK_URL=
# Προαιρετικό shared secret, φεύγει ως x-auragram-secret header
LEAD_WEBHOOK_SECRET=

# Analytics (φορτώνουν ΜΟΝΟ μετά από συγκατάθεση cookies)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
