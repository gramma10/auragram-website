# ─────────────────────────────────────────────────────────────
#  AURAGRAM — Αντιγράψτε το σε .env.local και συμπληρώστε
# ─────────────────────────────────────────────────────────────

# Το domain σας (χωρίς / στο τέλος)
NEXT_PUBLIC_SITE_URL=https://auragram.gr

# Πού πάει το lead: το /exec URL του Google Apps Script web app (βλ. docs/apps-script/README.md).
# Χωρίς αυτό το lead απλώς καταγράφεται στα logs και η φόρμα δείχνει επιτυχία — ΜΗΝ το ξεχάσετε στο production.
LEAD_WEBHOOK_URL=
# Το κοινό μυστικό: στέλνεται ΜΕΣΑ στο JSON σώμα (field `secret`) — το Apps Script δεν διαβάζει headers.
# Πρέπει να ταυτίζεται με το Script Property LEAD_SECRET.
LEAD_WEBHOOK_SECRET=

# Analytics (φορτώνουν ΜΟΝΟ μετά από συγκατάθεση cookies)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
